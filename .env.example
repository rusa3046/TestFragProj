# Reddit API (read-only script app: https://www.reddit.com/prefs/apps)
# The user agent should be descriptive and carry a contact URL — that is what
# distinguishes a polite read-only research client from anonymous scraping.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=fragrance-graph/0.1 (research; +https://github.com/rusa3046/TestFragProj)

# YouTube Data API v3 (console.cloud.google.com -> enable the API -> API key)
# Issued immediately, no review. 10,000 quota units/day free.
YOUTUBE_API_KEY=

# Anthropic API
ANTHROPIC_API_KEY=

# SQLite database path
FRAGRANCE_DB_PATH=fragrance_graph.db
