# YouTube Data API v3 (console.cloud.google.com -> enable the API -> API key)
# The only comment source. Issued immediately, no review.
# 10,000 quota units/day free; commentThreads.list costs 1 per 100 comments.
YOUTUBE_API_KEY=

# Anthropic API — claim extraction, and drafting eval labels.
# Extraction measured at ~$0.40 per 1,000 comments.
ANTHROPIC_API_KEY=

# Fragella (api.fragella.com) — resolving mention text to a canonical bottle.
# Used ONLY for names and brands: its notes, accords and similarity
# endpoints are off limits, see SPEC.md. Free tier is 20 requests/month.
FRAGELLA_API_KEY=

# SQLite database path. The working corpus lives at data/fragrance_graph.db;
# the file itself is gitignored and rebuilt from data/corpus/.
FRAGRANCE_DB_PATH=data/fragrance_graph.db

# Reddit is NOT used. API access was refused to this project, which is why
# YouTube is the only comment source. The PRAW code and the praw dependency
# were removed on 2026-08-10; the shared writer now lives in ingest/store.py.

# If your runner reserves ANTHROPIC_API_KEY for its own agent auth and will
# not pass yours through (Claude Code does this), set the key under this
# name instead. ANTHROPIC_API_KEY still wins when both are present.
FRAGRANCE_ANTHROPIC_API_KEY=
