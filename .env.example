# YouTube Data API v3 (console.cloud.google.com -> enable the API -> API key)
# The only comment source. Issued immediately, no review.
# 10,000 quota units/day free; commentThreads.list costs 1 per 100 comments.
YOUTUBE_API_KEY=

# Anthropic API — claim extraction, and drafting eval labels.
# Extraction measured at $0.37-$0.50 per 1,000 comments. The rate rises
# as searches get more specific: a thread about one bottle asserts more
# claims per comment, and output is ~69% of the bill.
ANTHROPIC_API_KEY=


# PostgreSQL connection string. The database is derived and disposable —
# rebuilt from data/corpus/ by `corpus import` — so nothing in it is worth
# backing up.
#
# Which form you need depends on how you installed Postgres:
#
#   Homebrew:  postgresql:///fragrance_graph
#              (the superuser is your macOS username, not "postgres")
#   Docker:    postgresql://postgres:postgres@localhost:5432/fragrance_graph
#
# `role "postgres" does not exist` means you have Homebrew and used the
# Docker form. See README > Setup.
FRAGRANCE_DB_URL=postgresql:///fragrance_graph

# The test suite uses its own database and rebuilds the schema at the start
# of every session. Do not point this at the one above.
FRAGRANCE_TEST_DB_URL=postgresql:///fragrance_graph_test

# Reddit is NOT used. API access was refused to this project, which is why
# YouTube is the only comment source. The PRAW code and the praw dependency
# were removed on 2026-08-10; the shared writer now lives in ingest/store.py.

# If your runner reserves ANTHROPIC_API_KEY for its own agent auth and will
# not pass yours through (Claude Code does this), set the key under this
# name instead. ANTHROPIC_API_KEY still wins when both are present.
FRAGRANCE_ANTHROPIC_API_KEY=
