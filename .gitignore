__pycache__/
*.pyc
.venv/
*.db
.env
.pytest_cache/
.ruff_cache/
*.egg-info/

# Raw pasted scratch content — never commit. The reviewed corpus export
# under data/corpus/ is committed deliberately; these are not that.
seed/local-*.txt
labels*.json
*.db.stray

# Subagent worktrees — separate checkouts, not part of this tree
.claude/worktrees/

# Generated comparison pages. A build output, not an artifact: a pure
# function of data/corpus/, costing no quota, money or judgement to
# reproduce. Same reasoning that keeps products out of the corpus.
site/

# Labelling scratch files — templates and drafts are working files, not
# corpus. The labels themselves land in data/corpus/eval_labels.jsonl.
next*.json
curate*.json
drafted*.json
silent*.json
labels*.json
todraft*.json
review*.json
blind*.json

# Codex review output. Ignored so `git status --porcelain` stays empty —
# scripts/codex-agent.sh refuses to run on a dirty tree, and findings written
# into the repo would otherwise block the next review.
.codex-findings/

# The spend ledger's lock file. Created beside the ledger on every paid
# path; it carries no data and must never dirty the tree, because both
# codex-agent.sh lanes refuse to run on a dirty tree.
*.jsonl.lock

# ADHD raw runs and assembled context files. The reviewed decision record
# under docs/decisions/ is committed deliberately; these are the machine
# output it was rendered from, reproducible only by spending again but of no
# value once the verdicts are written.
.adhd-runs/
